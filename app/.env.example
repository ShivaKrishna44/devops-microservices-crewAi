# Copy to .env and fill in. NEVER commit the real .env.

# LLM for the CrewAI agents
CREWAI_LLM=openrouter/openrouter/free
OPENROUTER_API_KEY=your-openrouter-key

# Target cluster
EKS_CLUSTER_NAME=expense-dev
AWS_REGION=us-east-1

# Path to the Terraform dir that manages the EKS cluster (has the eks_version variable).
# Defaults to ../Terraform relative to app/. Override if your layout differs.
# TERRAFORM_DIR=/absolute/path/to/Terraform

# Where the approval gate stores its audit trail (defaults to ../state/approvals.json)
# APPROVAL_STORE=/absolute/path/to/state/approvals.json

# ── Guardrail / approval policy ──────────────────────────────────────
# Approvals expire after this many minutes (0 = never)
APPROVAL_TTL_MINUTES=60
# Regions the agent may operate in (comma-separated; empty = any)
ALLOWED_REGIONS=us-east-1
# Substrings that mark a cluster as production (stricter rules apply)
PROD_CLUSTER_MARKERS=prod,production,live
# Require two distinct approvers for production clusters
REQUIRE_TWO_PERSON_FOR_PROD=true
# Sequence gate: max latency (s) for `kubectl get nodes` after the control-plane
# upgrade before nodes are touched. API server must answer within this bound.
APISERVER_LATENCY_THRESHOLD_S=10

# Live availability monitor (runs DURING the node rollover)
# Alarm if a critical deployment loses more than this fraction of its baseline
# healthy pods. 0.20 = alarm on a >20% drop.
AVAILABILITY_DROP_THRESHOLD=0.20
# Comma-separated namespaces considered 'critical' (empty = all app namespaces)
CRITICAL_NAMESPACES=order-service,payment-service,user-service
# Optional Slack-style webhook to sound the alarm externally
# ALARM_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# On breach, HALT further node draining (cordon old nodes) so a human can debug.
# Set to false for alarm-only behavior.
HALT_ON_AVAILABILITY_BREACH=true

# AWS credentials: prefer a profile, env vars, or IRSA/instance role.
# Do NOT paste long-lived keys here for a repo that will be shared.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
