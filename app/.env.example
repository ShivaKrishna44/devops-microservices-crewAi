# ============================================
# Environment Variables (copy this to .env and fill in real values)
# NEVER commit .env to Git — only .env.example
# ============================================

# LangSmith tracing (optional — for debugging agent flow)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=Monitor-Devops

# LLM Provider (Groq — free tier available)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.6-27b

# GitHub (for workflow status checks)
GITHUB_TOKEN=your-github-pat-here
TARGET_REPO=YourOrg/your-repo-name

# AWS (for EC2 health + cost checks)
AWS_ACCESS_KEY_ID=your-aws-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-here
AWS_DEFAULT_REGION=us-east-1
